# systemd unit for the PLEA keeper. Install (as root), adjusting the paths and user:
#   cp keeper.service /etc/systemd/system/plea-keeper.service
#   systemctl daemon-reload && systemctl enable --now plea-keeper
#   journalctl -u plea-keeper -f
[Unit]
Description=PLEA keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plea-keeper
WorkingDirectory=/opt/plea-keeper/keeper
ExecStart=/usr/bin/env node --env-file=/opt/plea-keeper/keeper/.env src/main.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/plea-keeper/keeper
MemoryMax=512M

[Install]
WantedBy=multi-user.target
