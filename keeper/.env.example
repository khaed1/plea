# PLEA keeper settings. Copy to .env and chmod 600 .env (it holds the keeper's key).

# Read RPC (a provider URL with your own key is more reliable than a public one).
RPC_URL=https://ethereum-rpc.publicnode.com
# Sends go through a private relay: nobody can copy a delivery's tip, and a send that would revert is not included.
SEND_RPC_URL=https://rpc.flashbots.net/fast

# PleaLaunch on Ethereum (filled in after the launch).
LAUNCH=

# The keeper's own wallet: create it on this machine (cast wallet new), fund it with ~0.05 ETH, nothing else.
KEEPER_PRIVATE_KEY=
# Instead of a key, a dry run may name the address it simulates from.
# KEEPER_ADDRESS=

STATE_FILE=./keeper-state.json
# 1 = simulate and log only. Start with 1.
DRY_RUN=1

POLL_SECONDS=12
REBALANCE_EVERY_SECONDS=600
REBALANCE_MIN_RESERVE_IMD=1
MAX_FEE_GWEI=10
URGENT_MAX_FEE_GWEI=50
PRIORITY_GWEI=0.05
URGENT_PRIORITY_GWEI=0.5
MIN_ETH=0.01
IMD_SLOW_MINUTES=5

# Telegram alerts: a bot token from @BotFather and your chat id. Leave empty for log-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_REPEAT_HOURS=6
SUMMARY_UTC_HOUR=8
